<!--
theme name:     Maximusbat
version         3.0
-->

<?xml version="1.0" encoding="UTF-8"?>
<theme>
    <formatVersion>7</formatVersion>

    <include subset="fontbase" name="Default" displayName="Default">./maximusbat_base.xml</include>
    <include subset="fontbase" name="DS-DIGI" displayName="DS-DIGI">./maximusbat_dsdigi.xml</include>
    <include subset="fontbase" name="OpenSans" displayName="OpenSans">./maximusbat_opensans.xml</include>
    <include subset="fontbase" name="Slapstick" displayName="SF Slapstick Comic Bold">./maximusbat_slapstick.xml</include>

    <include name="coinopsnext2">${themePath}/_coinops/_viewsyst/coinopsnext2.xml</include>

    <include>./_inc/system/options.xml</include>

    <view name="system">
        <image name="maximusbat_welcome" extra="true" ifSubset="welcome:On">
            <path>./_inc/images/welcome/en.png</path>
            <path lang="it">./_inc/images/welcome/it.png</path>
            <path lang="fr">./_inc/images/welcome/fr.png</path>
            <path lang="de">./_inc/images/welcome/de.png</path>
            <path lang="es">./_inc/images/welcome/es.png</path>
            <pos>0.5 0.5</pos>
            <size>1 1</size>
            <origin>0.5 0.5</origin>
            <zIndex>9999</zIndex>
        </image>
    </view>

</theme>
